# rw-cleaner на сервере: скопировать в .env и заполнить.
# Значения подключения к БД — те же, что у user-notify (MI_UN_POSTGRES_*),
# но одной строкой. Спецсимволы в пароле (@ : / % # ?) — URL-кодировать.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB

# RWMS на этом же сервере (как MI_UN_RWMS_ADDR / MI_UN_RWMS_PORT у user-notify).
RWMS_HOST=localhost
RWMS_PORT=50052

# Остальное — по умолчанию (README, раздел «Настройки»). Для первых
# dry-run-запусков ничего менять не нужно.
# CLEANER_MODE=expired
# CLEANER_TIER=never_connected
# GRACE_DAYS=90
# MAX_DELETIONS=25
# PAGE_SIZE=500

# --execute через env не включается (EXECUTE=true игнорируется намеренно),
# только флагом, а run.sh дополнительно требует RW_CLEANER_ALLOW_EXECUTE=yes.
